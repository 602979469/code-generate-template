# ============================================================
# generate-example.yaml — 全功能示例配置（手动等价版）
# 用法: ./gen.sh <本文件路径>
#
# 本文件 = generateExample: false + tables 手动配置 example 业务表，
# 效果与 generateExample: true 完全等同（唯一的 Example 类，全量功能演示）：
#   - 枚举转换    user_type(int) / status(varchar)
#   - JSON        profile(jsonObject→Profile) / tags(jsonArray→List<Tag>) / extra(json 原样)
#   - 类型转换    login_count(bigint→int 强制转换)
#   - 逻辑删除    del_flag（查询过滤、删除变 UPDATE）
#
# 前置条件：先执行同目录 example.sql 创建 example 表（业务表需先建表），例如:
#   mysql -uroot -p123456 < example.sql
# 说明：example=true 会自动建表并额外生成 Tag/Profile 两个示例 POJO（javaObject 绑定用）；
#       手动跑本文件时这两个 POJO 需自行提供（复制 example=true 输出的两个文件，
#       或把下方 tags/profile 的 javaObject 去掉，使用默认 List<Object>/Map<String,Object>）。
# ============================================================

generateExample: false

# ---------------- 项目命名（全部必填，无默认值） ----------------
projectPrefix: AiProd
toolPrefix: AiProd
groupId: com.jakt
projectArtifactPrefix: aiprod

# ---------------- 数据库（配置了 tables 时必填） ----------------
jdbc:
  url: jdbc:mysql://localhost:3306/aiplatform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
  username: root
  password: "123456"

# 生成输出根目录（项目骨架 init 与表级 CRUD 的落点）
outputDir: /Users/jakt/IdeaProjects/AiProd

# ---------------- tables：example 业务表全量配置 ----------------
# 以下配置与 generateExample: true 内置配置完全一致，生成效果等同。
tables:
  - db_table_name: example
    model_name: Example
    model_comment: 示例
    logicDelete:                    # 逻辑删除
      enable: true
      column_name: del_flag
      normal_value: 0
      delete_value: 1
    columns:
      user_type:                    # int 枚举
        type: enum
        enum:
          className: UserTypeEnum
          codeType: Integer
          values:
            - { code: 0, name: SYSTEM_USER, desc: 系统用户 }
            - { code: 1, name: NORMAL_USER, desc: 普通用户 }
      status:                       # varchar 枚举
        type: enum
        enum:
          className: UserStatusEnum
          codeType: String
          values:
            - { code: ENABLED,  name: ENABLED,  desc: 启用 }
            - { code: DISABLED, name: DISABLED, desc: 停用 }
      login_count:
        type: Integer               # bigint → int 强制转换（风险自负）
      tags:
        type: jsonArray             # json 数组 → List<Tag>
        javaObject: com.jakt.aiprod.core.model.domain.Tag
      profile:
        type: jsonObject            # json 对象 → Profile
        javaObject: com.jakt.aiprod.core.model.domain.Profile
      # extra 列不配置 type，演示 json → String 默认映射
