# ============================================================
# generate.yaml — code-generate-template 生成配置模板
# 用法: ./gen.sh <本文件路径>
# 所有配置都从本文件读取,不再使用命令行参数。
# ============================================================

# ---------------- 示例代码（可选，默认不开启） ----------------

# 是否生成 example 示例代码：true 时后台创建 example 表（CREATE TABLE IF NOT EXISTS）
# 并生成完整示例模块（含枚举 / jsonArray / jsonObject / 强制类型转换 / 逻辑删除演示）。
# 示例代码已存在则跳过（无强制覆盖选项）。
generateExample: false

# ---------------- 全局逻辑删除（可选，默认不开启） ----------------
# enable: true 时 column_name / normal_value / delete_value 三项必填（前置校验）；
# 表级 tables[].logicDelete 可覆盖全局（见下方示例）。
# globalLogicDelete:
#   enable: true
#   column_name: del_flag
#   normal_value: 0
#   delete_value: 1

# ---------------- 项目命名(全部必填,无默认值) ----------------

# 项目前缀(驼峰,用于启动类名),如 AiProd -> AiProdApplication
# 必填;约束: 驼峰字母/数字,如 AiProd
projectPrefix: AiProd

# 工具类/异常/常量前缀(驼峰,由你自己指定,代码不做转换)
# 必填;约束: 驼峰字母/数字,如 AiProd(AiProdInvoker/AiProdException/AiProdTemplate)
toolPrefix: AiProd

# Maven groupId
# 必填;约束: 如 com.jakt
groupId: com.jakt

# artifactId/包名后缀
# 必填;约束: 小写字母/数字,如 aiprod。Java 包名不允许连字符,
# 如需连字符项目名(如 ai-prod)请生成后自行调整 artifactId
projectArtifactPrefix: aiprod

# ---------------- 数据库(只要配置了 tables 就必填) ----------------
jdbc:
  # 数据库连接串;必填(配置了 tables 时)
  url: jdbc:mysql://localhost:3306/aiplatform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
  # 数据库用户名;必填(配置了 tables 时)
  username: root
  # 数据库密码;必填(配置了 tables 时)
  password: "123456"

# 生成输出根目录(项目骨架 init 与表级 CRUD 的落点)
# 必填;约束: 绝对或相对路径
outputDir: /Users/jakt/IdeaProjects/AiProd

# ---------------- tables(可选,不配置则不生成表) ----------------
# sql 跟随本配置: 每张配置的表在目标项目生成一个 sql/{db_table_name}.sql,
# 内容为该表的真实建表语句 (SHOW CREATE TABLE); 已存在的文件默认跳过,
# force_create: true 时覆盖。骨架不再内置任何表的 DDL。
# 要生成的表列表,每一项是一个对象:
#   db_table_name : 数据库表名(必填),如 sys_user
#   model_name    : 映射到 Java 的对象名(必填),如 User。
#                   直接指定,替代旧的"表名前缀剥离"逻辑;
#                   例: sys_user -> User、member -> Member
#   model_comment : 中文实体名(必填),用于生成代码的所有注释拼接
#                   (javadoc、@Tag、日志等),不要用表注释(如"用户信息表")自动截取。
#                   例: sys_user -> 用户、member -> 会员
#   force_create  : 是否强制覆盖该表已存在的文件(可选,默认 false)
#                   - false(默认): 若目标项目已存在该表的 DO
#                     (通过 common/dal/.../dataobject/{model_name}DO.java 判断),
#                     跳过该表,防止覆盖已经写好的文件
#                   - true: 强制覆盖该表所有 19 个文件
#                     ⚠️ 危险: 会覆盖你手动修改过的代码,且不可恢复,谨慎使用!
#   generateController: 是否生成 Controller 及 web 专属文件(可选,默认 true)
#                   false = 内部表,只生成 DO/Mapper/Model/QueryParam/Repository/Service/Manager
#   logicDelete    : 表级逻辑删除配置(可选,覆盖全局 globalLogicDelete),字段同全局
#   columns        : 列级转换配置(可选,键为数据库列名),未配置的列按默认映射
#                    列配置项:
#                      type        : enum / json / jsonArray / jsonObject / Java 类型(如 Integer)
#                                    - type: enum      -> 枚举转换,配 enum 块
#                                    - type: json      -> 原始 JSON 字符串
#                                    - type: jsonArray -> 数组,配 javaObject(可选) 元素类型
#                                    - type: jsonObject-> 对象,配 javaObject(可选) 目标类型
#                                    - type: Integer   -> 强制类型转换(风险自负)
#                      javaObject  : jsonArray 元素类型 / jsonObject 目标类型(全限定类名,可选)
#                      enum        : 枚举配置(className/codeType/values)
tables:
  - db_table_name: sys_job_log
    model_name: JobLog
    model_comment: 任务日志
    force_create: false
    generateController: false
    columns:
      user_type:
        type: enum
        enum:
          className: UserTypeEnum
          codeType: Integer
          values:
            - { code: 0, name: SYSTEM_USER, desc: 系统用户 }
            - { code: 1, name: NORMAL_USER, desc: 普通用户 }
