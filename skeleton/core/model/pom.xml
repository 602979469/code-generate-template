<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jakt</groupId>
        <artifactId>aiplatform-core</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>aiplatform-core-model</artifactId>
    <name>aiplatform-core-model</name>
    <description>核心领域模型：Model、查询参数、异常体系、返回体、业务模板（仅依赖 lombok/slf4j）</description>

    <dependencies>
        <dependency>
            <groupId>com.jakt</groupId>
            <artifactId>aiplatform-common-util</artifactId>
        </dependency>
        <!-- slf4j：AiPlatformTransactionTemplate 统一异常日志 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Hutool：AiPlatformTransactionTemplate 异常解析（ExceptionUtil / EnumUtil） -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- Jackson 注解：生成枚举的 @JsonFormat(OBJECT) / @JsonCreator 序列化（provided，无运行期依赖） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
