<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jakt.aiplatform.common.dal.mapper.UserMapper">

    <!-- 与 sys_user 表一一对应，id/create_time/update_time 由 BaseDO 承载；
         create_by/update_by/del_flag 等审计字段后续由 BizDO 启用，当前不映射 -->
    <sql id="selectUserColumns">
        id, dept_id, login_name, user_name, user_type, email, phonenumber, sex, avatar,
        password, salt, status, login_ip, login_date, pwd_update_date,
        create_time, update_time, remark
    </sql>

    <!--
        查询条件与 UserQueryParam 的对应关系：
        username -> login_name（登录账号，模糊）
        nickname -> user_name（用户昵称，模糊）
        status   -> status（账号状态）
    -->
    <sql id="queryConditions">
        <where>
            <if test="username != null and username != ''">
                AND login_name LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="nickname != null and nickname != ''">
                AND user_name LIKE CONCAT('%', #{nickname}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
    </sql>

    <select id="selectById" resultType="com.jakt.aiplatform.common.dal.dataobject.UserDO">
        SELECT <include refid="selectUserColumns"/>
        FROM sys_user
        WHERE id = #{id}
    </select>

    <select id="selectByLoginName" resultType="com.jakt.aiplatform.common.dal.dataobject.UserDO">
        SELECT <include refid="selectUserColumns"/>
        FROM sys_user
        WHERE login_name = #{loginName}
    </select>

    <select id="selectPage" resultType="com.jakt.aiplatform.common.dal.dataobject.UserDO">
        SELECT <include refid="selectUserColumns"/>
        FROM sys_user
        <include refid="queryConditions"/>
        ORDER BY id DESC
        LIMIT #{offset}, #{pageSize}
    </select>

    <select id="selectList" resultType="com.jakt.aiplatform.common.dal.dataobject.UserDO">
        SELECT <include refid="selectUserColumns"/>
        FROM sys_user
        <include refid="queryConditions"/>
        ORDER BY id DESC
    </select>

    <select id="countByQuery" resultType="long">
        SELECT COUNT(*)
        FROM sys_user
        <include refid="queryConditions"/>
    </select>

    <!-- create_by/update_by/del_flag 不参与插入，使用表默认值 -->
    <insert id="insert" parameterType="com.jakt.aiplatform.common.dal.dataobject.UserDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (dept_id, login_name, user_name, user_type, email, phonenumber, sex, avatar,
                              password, salt, status, login_ip, login_date, pwd_update_date,
                              create_time, update_time, remark)
        VALUES (#{deptId}, #{loginName}, #{userName}, #{userType}, #{email}, #{phonenumber}, #{sex}, #{avatar},
                #{password}, #{salt}, #{status}, #{loginIp}, #{loginDate}, #{pwdUpdateDate},
                #{createTime}, #{updateTime}, #{remark})
    </insert>

    <!-- 更新不涉及主键与创建时间（create_time） -->
    <update id="update" parameterType="com.jakt.aiplatform.common.dal.dataobject.UserDO">
        UPDATE sys_user
        SET dept_id = #{deptId},
            login_name = #{loginName},
            user_name = #{userName},
            user_type = #{userType},
            email = #{email},
            phonenumber = #{phonenumber},
            sex = #{sex},
            avatar = #{avatar},
            password = #{password},
            salt = #{salt},
            status = #{status},
            login_ip = #{loginIp},
            login_date = #{loginDate},
            pwd_update_date = #{pwdUpdateDate},
            update_time = #{updateTime},
            remark = #{remark}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM sys_user WHERE id = #{id}
    </delete>
</mapper>
